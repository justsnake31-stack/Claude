{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-syntax.sh",
            "timeout": 30,
            "statusMessage": "Проверяю синтаксис JavaScript…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-version-bump.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["context7"]
}
